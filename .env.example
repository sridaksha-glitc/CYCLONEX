# ==============================================================================
# CYCLONEX ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development
# NEVER commit .env to version control
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_MODE=DEMO          # Options: DEMO | LIVE | HYBRID (falls back gracefully)

# --- Backend API (FastAPI) ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# --- OpenWeather API (Live Meteorological Observations) ---
# Sign up at https://openweathermap.org/api to obtain a key.
# Required for LIVE mode operation. If unset in LIVE mode, backend returns a clear configuration error.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- MOSDAC / ISRO Satellite (Near-Real-Time Geostationary Imagery) ---
# Optional credentials if accessing authenticated MOSDAC products.
# Open NRT geostationary imagery operates anonymously without credentials.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_DATASET_ID=
MOSDAC_NRT_URL=https://mausam.imd.gov.in/Satellite/3Dasiasec_ir1.jpg

# --- Supabase Database & Storage ---

# Create a free project at https://supabase.com
# If unset, CYCLONEX automatically operates in local SQLite/in-memory fallback mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Automation & Alerts (n8n) ---
# Webhook URL configured in n8n for triggering alert workflows
N8N_WEBHOOK_URL=http://localhost:5678/webhook/cyclonex-alert

# --- Frontend (Next.js) ---
# For local backend use: http://localhost:8000. For production Vercel deployment use:
NEXT_PUBLIC_API_URL=https://cyclonex-backend.vercel.app
NEXT_PUBLIC_DATA_MODE=DEMO
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
